{% comment %} Cart {% endcomment %}
<div style="padding-top:100px; min-height:80vh;">
  <div class="section">
    <h1 class="section-title">Tu carrito</h1>
    {% if cart.item_count == 0 %}
      <p style="color:var(--text-light); margin:2rem 0;">Tu carrito está vacío.</p>
      <a href="/collections/all" class="btn-primary">Ver productos</a>
    {% else %}
      {% form 'cart', cart %}
        {% for item in cart.items %}
        <div style="display:flex; gap:1.5rem; align-items:center; padding:1.5rem 0; border-bottom:1px solid rgba(180,210,170,0.3);">
          <div style="width:80px; height:80px; background:var(--sage-pale); border-radius:2px; overflow:hidden; flex-shrink:0;">
            {% if item.image %}
              <img src="{{ item.image | img_url: '160x160' }}" alt="{{ item.title }}" style="width:100%; height:100%; object-fit:cover;">
            {% else %}
              <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; font-size:2rem;">🌿</div>
            {% endif %}
          </div>
          <div style="flex:1;">
            <div style="font-family:var(--font-display); font-size:1.1rem; color:var(--forest); margin-bottom:0.3rem;">{{ item.product.title }}</div>
            <div style="font-size:0.82rem; color:var(--text-light);">{{ item.variant.title }}</div>
          </div>
          <div style="display:flex; align-items:center; gap:1rem;">
            <input type="number" name="updates[{{ item.key }}]" value="{{ item.quantity }}" min="0" style="width:60px; padding:0.4rem; border:1px solid var(--sage); border-radius:2px; text-align:center; font-family:var(--font-body);">
            <span style="font-family:var(--font-display); font-size:1.2rem; color:var(--forest);">{{ item.line_price | money }}</span>
          </div>
        </div>
        {% endfor %}
        <div style="display:flex; justify-content:space-between; align-items:center; margin-top:2rem; flex-wrap:wrap; gap:1rem;">
          <div>
            <div style="font-size:0.75rem; color:var(--text-light); letter-spacing:0.1em; text-transform:uppercase;">Total</div>
            <div style="font-family:var(--font-display); font-size:2rem; color:var(--forest);">{{ cart.total_price | money }}</div>
          </div>
          <div style="display:flex; gap:1rem; flex-wrap:wrap;">
            <button type="submit" name="update" class="btn-secondary">Actualizar</button>
            <button type="submit" name="checkout" class="btn-primary">Finalizar compra</button>
          </div>
        </div>
      {% endform %}
    {% endif %}
  </div>
</div>
